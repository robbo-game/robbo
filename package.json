{
  "name": "robbo",
  "version": "1.0.0",
  "private": true,
  "description": "Browser version of Robbo built from TypeScript",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "import:levels": "node scripts/levels/import-legacy-levels.cjs",
    "check:levels": "node scripts/levels/import-legacy-levels.cjs --check",
    "build": "npm run check:levels && tsc --noEmit && tsc --project tsconfig.test.json && tsc --project tsconfig.game.json && vite build",
    "test": "vitest run",
    "test:input": "npm run package && node tests/browser/input.check.cjs",
    "test:touch-shooting": "npm run package && node tests/browser/touch-shooting.check.cjs",
    "test:autosave": "npm run package && node tests/browser/autosave.check.cjs",
    "test:session-browser": "npm run package && node tests/browser/session.check.cjs",
    "test:viewport": "npm run package && node tests/browser/viewport.check.cjs",
    "test:browser": "npm run package && node tests/browser/browser.check.cjs",
    "test:artwork": "npm run package && node tests/browser/artwork.check.cjs",
    "test:performance": "npm run package && node tests/browser/render-performance.check.cjs",
    "capture:artwork": "npm run package && node scripts/dev/capture-artwork-review.cjs",
    "package": "npm run build && node scripts/release/package-release.cjs",
    "start": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "test:tooling": "node --test tests/tooling/*.test.cjs",
    "preview": "node scripts/dev/serve.cjs",
    "test:dev": "node tests/browser/dev.check.cjs"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
